# --- Model provider (pick one) ---
ASSISTANT_PROVIDER=groq                 # groq | anthropic | openai_compat
# ASSISTANT_MODEL=llama-3.3-70b-versatile   # optional; each provider has a sensible default

# Groq (free tier; get a key at https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ASSISTANT_NATIVE_WEB_SEARCH=true        # use the provider's server-side web search (Anthropic only)

# OpenAI-compatible endpoints (OpenAI, OpenRouter, vLLM, Ollama, ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- App ---
ASSISTANT_DATA_DIR=./data
ASSISTANT_MAX_STEPS=12
ASSISTANT_TOOL_OUTPUT_CHARS=12000       # max characters of a page/file returned to the model per call (lower it on free tiers)
ASSISTANT_TOOL_TIMEOUT=60
ASSISTANT_APPROVAL_TIMEOUT=900
ASSISTANT_MAX_UPLOAD_MB=15
ASSISTANT_ALLOW_REGISTRATION=true

# --- Optional: email sending (tool is disabled unless SMTP_HOST is set) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=you@example.com
# SMTP_STARTTLS=true
